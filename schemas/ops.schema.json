        "default": 16
      },
      "seed": {
        "type": "integer",
        "description": "random seed"
      },
      "key": {
        "type": "string",
        "description": "key like C, F#, Bb"
      },
      "bpm": {
        "type": "number",
        "description": "tempo"
      },
      "out": {
        "type": "string",
        "description": "write score/project here"
      },
      "wav": {
        "type": "string",
        "description": "also render a WAV"
      },
      "_fields": {
        "type": "string",
        "description": "optional: comma-separated result keys to keep (saves tokens)"
      }
    },
    "required": []
  },
