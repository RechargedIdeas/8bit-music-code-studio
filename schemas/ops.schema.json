  "compose": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "free text, e.g. 'tense boss fight 16 bars in E'",
        "default": ""
      },
      "context": {
        "type": "string",
        "description": "game context: title-screen, menu, overworld, town, shop, forest, dungeon, cave, castle, battle, boss, final-boss, chase, puzzle, stealth, underwater, space, lofi-break, credits, victory, level-clear, game-over, cutscene-sad"
      },
      "style": {
        "type": "string",
        "description": "style (overrides context)"
      },
      "bars": {
        "type": "integer",
        "description": "length in bars"
      },
      "key": {
        "type": "string",
        "description": "key like C, F#, Bb"
      },
      "bpm": {
        "type": "number",
        "description": "tempo"
      },
      "seed": {
        "type": "integer",
        "description": "seed (same args + seed = same result)",
        "default": 0
      },
      "model": {
        "type": "string",
        "description": "tiny (Markov+rules, default) | rules | <ml plugin>",
        "default": "tiny"
      },
      "candidates": {
        "type": "integer",
        "description": "generate N and keep the best by critique score",
        "default": 4
      },
      "loop": {
        "type": "boolean",
        "description": "make it a seamless loop (default: from context)"
      },
      "out": {
        "type": "string",
        "description": "also save the song (.8bt/.8bms)"
      },
      "wav": {
        "type": "string",
        "description": "also render audio (wav/ogg/mp3/flac)"
      },
      "_fields": {
        "type": "string",
        "description": "optional: comma-separated result keys to keep (saves tokens)"
      }
    },
    "required": []
  },
