    "/ops/soundpack": {
      "post": {
        "operationId": "soundpack",
        "summary": "Render a retro SFX pack (WAV files + manifest.json + Howler-style sprite).",
        "tags": [
          "core"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "names": {
                    "type": "string",
                    "description": "comma list of sfx and/or sets (platformer, shooter, ui, rpg) or 'all'",
                    "default": "all"
                  },
                  "out": {
                    "type": "string",
                    "description": "output folder",
                    "default": "sfx"
                  },
                  "variants": {
                    "type": "integer",
                    "description": "variants per sound (deterministic)",
                    "default": 1
                  },
                  "seed": {
                    "type": "integer",
                    "description": "seed (same args + seed = same result)",
                    "default": 0
                  },
                  "sprite": {
                    "type": "boolean",
                    "description": "also write sprite.wav + sprite.json",
                    "default": true
                  },
                  "sr": {
                    "type": "integer",
                    "description": "sample rate",
                    "default": 44100
                  },
                  "_fields": {
                    "type": "string",
                    "description": "optional: comma-separated result keys to keep (saves tokens)"
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "result object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "{error}"
          }
        }
      }
    },
    "/ops/stems": {
      "post": {
        "operationId": "stems",
        "summary": "Render one WAV per track (plus mix.wav) into a folder.",
        "tags": [
          "core"
        ],
