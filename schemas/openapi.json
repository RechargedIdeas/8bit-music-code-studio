{
  "openapi": "3.1.0",
  "info": {
    "title": "8Bit Music Code Studio HTTP API",
    "version": "1.1.1",
    "description": "Start with `8bms serve` (default http://127.0.0.1:8765). One registry powers CLI, HTTP, MCP and ACP."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "liveness",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/ops": {
      "get": {
        "summary": "list ops with JSON schemas",
        "responses": {
          "200": {
            "description": "op map"
          }
        }
      }
    },
    "/tools": {
      "get": {
        "summary": "tool cards (same as `8bms tools --json`)",
        "responses": {
          "200": {
            "description": "list"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "this document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1"
          }
        }
      }
    },
    "/batch": {
      "post": {
        "summary": "run several ops in order; \"$prev\" / \"$<id>\" in args reference earlier handles",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "jobs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "op": {
                          "type": "string"
                        },
                        "args": {
                          "type": "object"
                        },
                        "fields": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "op"
                      ]
                    }
                  }
                },
                "required": [
                  "jobs"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{results: [{id, ok, result | error}]}"
          }
        }
      }
    },
    "/prompt": {
      "post": {
        "summary": "stateful studio: notes, .8bt lines, /commands or English",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{reply}"
          }
        }
      }
    },
    "/ops/render": {
      "post": {
        "operationId": "render",
        "summary": "Render a song to audio (wav/ogg/mp3/flac).",
        "tags": [
          "core"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "description": "file .8bt/.8bms, 'demo' or gen:style:bars:seed"
                  },
                  "out": {
                    "type": "string",
                    "description": "output file (extension picks format)",
                    "default": "out.wav"
                  },
                  "loop": {
                    "type": "boolean",
                    "description": "render only the loop region",
                    "default": false
                  },
                  "seamless": {
                    "type": "boolean",
                    "description": "gapless loop file: loop region (or --bars) with the tail folded into the start",
                    "default": false
                  },
                  "bars": {
                    "type": "string",
                    "description": "bar range like 1-8"
                  },
                  "stems": {
                    "type": "string",
                    "description": "also write per-track stems into this folder"
                  },
                  "_fields": {
                    "type": "string",
                    "description": "optional: comma-separated result keys to keep (saves tokens)"
                  }
                },
                "required": [
                  "src"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "result object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "{error}"
          }
        }
      }
    },
    "/ops/export": {
      "post": {
        "operationId": "export",
        "summary": "Export a song as code/data: js, py, json, score (.8bt), project (.8bms) or plugin formats.",
        "tags": [
          "core"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "description": "song source"
                  },
                  "kind": {
                    "type": "string",
                    "description": "exporter name"
                  },
                  "out": {
                    "type": "string",
                    "description": "output path (default from title)"
                  },
                  "_fields": {
                    "type": "string",
                    "description": "optional: comma-separated result keys to keep (saves tokens)"
                  }
                },
                "required": [
                  "src",
                  "kind"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "result object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "{error}"
          }
        }
      }
    },
    "/ops/gen": {
      "post": {
        "operationId": "gen",
        "summary": "Generate a song in a style. Returns score text, or writes it to out (.8bt/.8bms).",
        "tags": [
          "core"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "style": {
                    "type": "string",
                    "description": "style name",
                    "default": "mellow-space"
                  },
                  "bars": {
                    "type": "integer",
                    "description": "length in bars",
                    "default": 16
                  },
                  "seed": {
                    "type": "integer",
                    "description": "random seed"
                  },
                  "key": {
                    "type": "string",
                    "description": "key like C, F#, Bb"
                  },
                  "bpm": {
                    "type": "number",
                    "description": "tempo"
                  },
                  "out": {
                    "type": "string",
                    "description": "write score/project here"
                  },
                  "wav": {
                    "type": "string",
                    "description": "also render a WAV"
                  },
                  "_fields": {
                    "type": "string",
                    "description": "optional: comma-separated result keys to keep (saves tokens)"
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "result object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "{error}"
          }
        }
      }
    },
