                    "type": "string",
                    "description": "file"
                  },
                  "_fields": {
                    "type": "string",
                    "description": "optional: comma-separated result keys to keep (saves tokens)"
                  }
                },
                "required": [
                  "src"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "result object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "{error}"
          }
        }
      }
    },
    "/ops/presets": {
      "post": {
        "operationId": "presets",
        "summary": "List instrument presets (and user instruments).",
        "tags": [
