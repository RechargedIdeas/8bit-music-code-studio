          }
        },
        "responses": {
          "200": {
            "description": "result object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "{error}"
          }
        }
      }
    },
    "/ops/check": {
      "post": {
        "operationId": "check",
        "summary": "Validate a score/project; returns ok or the first error.",
        "tags": [
