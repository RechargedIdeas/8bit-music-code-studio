        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "description": "song: file .8bt/.8bms, @handle, @last, demo or gen:style:bars:seed"
                  },
                  "amount": {
                    "type": "number",
                    "description": "0..1 how much to change",
                    "default": 0.3
                  },
                  "seed": {
                    "type": "integer",
                    "description": "seed (same args + seed = same result)",
                    "default": 0
                  },
                  "out": {
                    "type": "string",
                    "description": "also save the song (.8bt/.8bms)"
                  },
                  "wav": {
                    "type": "string",
                    "description": "also render audio (wav/ogg/mp3/flac)"
                  },
                  "_fields": {
                    "type": "string",
                    "description": "optional: comma-separated result keys to keep (saves tokens)"
                  }
                },
