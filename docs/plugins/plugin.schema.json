{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "8bms plugin.toml",
  "type": "object",
  "required": [
    "name",
    "version",
    "api_version",
    "types",
    "entry",
    "description"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "api_version": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "instrument",
          "effect",
          "style",
          "op",
          "exporter",
          "importer",
          "gui",
          "command",
          "visualizer",
          "midi",
          "ml"
        ]
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_][\\w.]*(:[A-Za-z_]\\w*)?$"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "filesystem",
          "network",
          "midi",
          "audio",
          "subprocess"
        ]
      }
    },
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
